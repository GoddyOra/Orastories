{
  "name": "orastories---home-of-high-quality-contemporary-romance-novels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./styles/tailwind.generated.css --minify",
    "build": "npm run build:css && vite build && node ./scripts/copy-static-pages.mjs && node ./scripts/generate-seo-pages.mjs",
    "preview": "vite preview",
    "upload:originals": "node ./scripts/upload_originals.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ./tests/e2e/run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.3.1",
    "mammoth": "^1.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
