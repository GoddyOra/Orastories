# --- Supabase ---
# Client-safe (VITE_ prefix ships to the browser bundle): from
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only — used by scripts/migrate-books-to-supabase.ts. Never prefix
# with VITE_, never commit, never expose to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- AWS S3 (canonical original file storage) ---
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET=your-orastories-bucket
ORASTORIES_API_KEY=YOUR_ORASTORIES_API_KEY

# Optional: set a custom prefix under the bucket (default is 'originals/')
S3_PREFIX=originals/
